# Print-size data figures for the painting inpainting paper.
font.family: sans-serif
font.sans-serif: Arial, Arimo, Helvetica, Liberation Sans, Nimbus Sans, DejaVu Sans
font.size: 6.5
axes.titlesize: 7.5
axes.labelsize: 6.5
legend.fontsize: 6.5
xtick.labelsize: 6.5
ytick.labelsize: 6.5
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: 8898B8
axes.labelcolor: 383848
axes.linewidth: 0.75
xtick.color: 383848
ytick.color: 383848
xtick.major.width: 0.75
ytick.major.width: 0.75
text.color: 383848
lines.linewidth: 0.75
axes.prop_cycle: cycler('color', ['2F6FB5', '7FB2E0', 'D9952B', '8A6FAE'])
figure.facecolor: white
savefig.dpi: 300
pdf.fonttype: 42
